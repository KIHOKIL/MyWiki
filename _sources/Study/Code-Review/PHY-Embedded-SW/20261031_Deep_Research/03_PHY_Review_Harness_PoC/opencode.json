{
  "$schema": "https://opencode.ai/config.json",
  "model": "litellm/qwen3-coder-plus",
  "small_model": "litellm/glm-4.5-air",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Internal Open-Weight LLM Gateway (DeepSeek / GLM / Qwen)",
      "options": {
        "baseURL": "{env:INTERNAL_LLM_BASE_URL}",
        "apiKey": "{env:INTERNAL_LLM_API_KEY}"
      },
      "models": {
        "deepseek-r1": {
          "name": "DeepSeek-R1 (Chief Verifier & Adversarial Cross-Reviewer)"
        },
        "deepseek-v3": {
          "name": "DeepSeek-V3 (Fast Pre-Push & General Reviewer)"
        },
        "qwen3-coder-plus": {
          "name": "Qwen3-Coder (Primary Coding & Domain Subagent)"
        },
        "glm-4.5": {
          "name": "GLM-4.5 (Cross-Model Domain Auditor)"
        }
      }
    }
  },
  "mcp": {
    "codebase-memory": {
      "type": "local",
      "command": ["codebase-memory-mcp", "--compile-commands", "build/compile_commands.json"],
      "enabled": true
    }
  },
  "permission": {
    "edit": "deny",
    "bash": "allow"
  }
}
