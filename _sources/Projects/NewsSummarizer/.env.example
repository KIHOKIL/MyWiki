# Google Gemini API 키 (필수, https://aistudio.google.com/app/apikey 에서 발급)
GEMINI_API_KEY="your_gemini_api_key_here"

# OpenAI API 키 (선택 사항 - Gemini 한도 초과 시 Fallback 용)
OPENAI_API_KEY="your_openai_api_key_here"

# 발신자 이메일 계정 (필수) (보내는 사람, 받는 사람이 같아도 됩니다)
EMAIL_SENDER="your_email@gmail.com"

# Gmail 앱 비밀번호 (Google 계정 보안 설정에서 생성, 띄어쓰기 없이 16자리)
EMAIL_PASSWORD="your_app_password_here"

# 기본 수신자 이메일 계정
EMAIL_RECEIVER="receiver_email@gmail.com"

# GitHub Personal Access Token (선택 사항 - GitHub API Rate Limit 403 방지용, 시간당 5000회로 증가)
GITHUB_TOKEN="your_github_pat_here"

# 구글 폼 응답 스프레드시트 CSV 웹 게시 URL (선택 사항 - 추가 구독자 목록 연동용)
SUBSCRIBERS_CSV_URL="your_google_sheet_csv_publish_url_here"
